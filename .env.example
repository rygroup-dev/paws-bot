# Copy to .env and fill in. Never commit .env.
# Private key of the wallet the bot plays with (use a dedicated game wallet).
PRIVATE_KEY=

# Telegram bot from @BotFather, and your chat id (send /start to the bot, it prints it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Referral used when the bot creates a new account (default TGPEMVTV)
REFERRAL_CODE=TGPEMVTV

# Optional: custom Robinhood Chain RPC (default: official, falls back to https://robinhood.drpc.org)
RPC_URL=
